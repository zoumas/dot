[user]
	email = zoumas@protonmail.com
	name = zoumas

[core]
	pager = delta
	editor = nvim

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[url "git@github.com:"]
	insteadOf = https://github.com

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rerere]
	enabled = true

[commit]
	verbose = true

# Machine-local overrides: work identity, host-specific url rewrites.
# Untracked, and silently skipped if the file does not exist.
[include]
	path = ~/.gitconfig.local
